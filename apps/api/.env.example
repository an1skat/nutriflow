APP_NAME=NutriFlow API
ENVIRONMENT=local
DEBUG=true

API_V1_PREFIX=/api/v1

MONGO_URI=mongodb://nutriflow:nutriflow_dev_password@localhost:27017/?authSource=admin
MONGO_DB=nutriflow_dev

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=nutriflow-api
JWT_AUDIENCE=nutriflow-web
ACCESS_TOKEN_TTL_MINUTES=15

REFRESH_TOKEN_PEPPER=replace-with-a-different-32-character-secret
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=5

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=nutriflow_access
REFRESH_COOKIE_NAME=nutriflow_refresh

CSRF_COOKIE_NAME=nutriflow_csrf

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
