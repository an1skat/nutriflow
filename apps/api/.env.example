APP_NAME=NutriFlow API
ENVIRONMENT=local
DEBUG=false

API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
REDOC_ENABLED=true
OPENAPI_ENABLED=true
DATABASE_HEALTH_ENABLED=true

MONGO_URI=mongodb://nutriflow:nutriflow_dev_password@localhost:27017/?authSource=admin
MONGO_DB=nutriflow_dev

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=nutriflow-api 
JWT_AUDIENCE=nutriflow-web
ACCESS_TOKEN_TTL_MINUTES=15

REFRESH_TOKEN_PEPPER=replace-with-a-different-32-character-secret
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=5

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=nutriflow_access
REFRESH_COOKIE_NAME=nutriflow_refresh

CSRF_COOKIE_NAME=nutriflow_csrf

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
MAX_REQUEST_BODY_BYTES=2097152
REQUEST_TIMEOUT_SECONDS=15
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60

AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_IP_REQUESTS=10
AUTH_LOGIN_SUBNET_REQUESTS=80
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_FAILURE_LOCK_SECONDS=900
AUTH_REFRESH_IP_REQUESTS=30
AUTH_REFRESH_SUBNET_REQUESTS=180
AUTH_REFRESH_WINDOW_SECONDS=60
AUTH_REFRESH_FAILURE_LIMIT=10
AUTH_REFRESH_FAILURE_LOCK_SECONDS=900
